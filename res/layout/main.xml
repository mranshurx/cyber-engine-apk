<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_root"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <android.widget.Toolbar
        android:id="@id/toolbar"
        android:background="@drawable/v48_toolbar"
        android:layout_width="fill_parent"
        android:layout_height="56.0dip"
        android:title="CYBER ENGINE"
        android:elevation="0.0dip"
        android:titleTextColor="#ffffffff" />

    <ScrollView
        android:paddingTop="56.0dip"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="14.0dip"
            android:paddingTop="18.0dip"
            android:paddingRight="14.0dip"
            android:paddingBottom="32.0dip"
            android:layoutAnimation="@anim/v48_layout_enter"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/v48_panel"
                android:padding="16.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:elevation="8.0dip">

                <FrameLayout
                    android:background="@drawable/v48_logo_frame"
                    android:layout_width="82.0dip"
                    android:layout_height="82.0dip"
                    android:elevation="8.0dip"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_gravity="center"
                        android:id="@id/logo"
                        android:background="@drawable/v48_logo_inner"
                        android:layout_width="70.0dip"
                        android:layout_height="70.0dip"
                        android:src="@drawable/app_icon"
                        android:scaleType="fitCenter"
                        android:contentDescription="CYBER ENGINE"
                        android:clipToOutline="true" />
                </FrameLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14.0dip"
                    android:layout_weight="1.0">

                    <TextView
                        android:textSize="21.0sp"
                        android:textStyle="bold"
                        android:textColor="#ffffffff"
                        android:id="@id/tx0"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="CYBER ENGINE"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:textSize="10.0sp"
                        android:textStyle="bold"
                        android:textColor="#ffff3d5c"
                        android:id="@id/tx1"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip"
                        android:text="PREMIUM CONTROL PANEL"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:textSize="8.0sp"
                        android:textStyle="bold"
                        android:textColor="#ffff3d5c"
                        android:background="@drawable/v48_badge"
                        android:paddingLeft="8.0dip"
                        android:paddingTop="4.0dip"
                        android:paddingRight="8.0dip"
                        android:paddingBottom="4.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.0dip"
                        android:text="CYBER ENGINE ONLINE" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:textSize="10.0sp"
                android:textStyle="bold"
                android:textColor="#ffff3d5c"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4.0dip"
                android:layout_marginTop="22.0dip"
                android:layout_marginBottom="8.0dip"
                android:text="// ENGINE CONTROL"
                android:fontFamily="monospace"
                android:letterSpacing="0.14" />

            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/v48_panel"
                android:padding="16.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:elevation="5.0dip">

                <TextView
                    android:textSize="9.0sp"
                    android:textStyle="bold"
                    android:textColor="#ff8b95a6"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="ACTIVATION STATUS"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1" />

                <Button
                    android:textSize="17.0sp"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:id="@id/control"
                    android:background="@drawable/v48_primary"
                    android:layout_width="fill_parent"
                    android:layout_height="64.0dip"
                    android:layout_marginTop="12.0dip"
                    android:text="@string/lw_start"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:stateListAnimator="@null" />

                <TextView
                    android:textSize="12.0sp"
                    android:textColor="#ff8b95a6"
                    android:gravity="center"
                    android:id="@id/status"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:text="@string/lw_idle"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone"
                android:background="@drawable/v48_panel"
                android:padding="14.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:textSize="11.0sp"
                    android:textStyle="bold"
                    android:textColor="#ffff5c78"
                    android:gravity="center"
                    android:id="@id/btn_tiktok"
                    android:background="@drawable/v48_secondary"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0.0dip"
                    android:layout_height="46.0dip"
                    android:layout_marginRight="6.0dip"
                    android:text="DAPATKAN KEY"
                    android:layout_weight="1.0" />

                <TextView
                    android:textSize="11.0sp"
                    android:textStyle="bold"
                    android:textColor="#ffff5c78"
                    android:gravity="center"
                    android:id="@id/btn_youtube"
                    android:background="@drawable/v48_secondary"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0.0dip"
                    android:layout_height="46.0dip"
                    android:layout_marginLeft="6.0dip"
                    android:text="CHANNEL WA"
                    android:layout_weight="1.0" />

                <TextView
                    android:id="@id/btn_wa"
                    android:visibility="gone"
                    android:layout_width="1.0dip"
                    android:layout_height="1.0dip"
                    android:text="" />
            </LinearLayout>

            <TextView
                android:textSize="9.0sp"
                android:textColor="#ff5a6270"
                android:gravity="center"
                android:id="@id/tx2"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22.0dip"
                android:text="CYBER ENGINE"
                android:fontFamily="monospace"
                android:letterSpacing="0.14" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
