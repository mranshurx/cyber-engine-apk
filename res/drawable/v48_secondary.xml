<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1A1A22" />
            <stroke android:width="1.0dip" android:color="#FFFF3D5C" />
            <corners android:radius="2.0dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF12121A" />
            <stroke android:width="1.0dip" android:color="#4DFF3D5C" />
            <corners android:radius="2.0dip" />
        </shape>
    </item>
</selector>
