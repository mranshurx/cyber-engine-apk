<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#ff9b9fa8" />
            <corners android:radius="16.0dip" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#ffc70016" android:endColor="#ff8d0010" android:angle="0.0" />
            <corners android:radius="16.0dip" />
            <stroke android:width="1.0dip" android:color="#ffff7888" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#ffff3855" android:endColor="#ffc70016" android:angle="0.0" android:centerColor="#ffff173c" />
            <corners android:radius="16.0dip" />
            <stroke android:width="1.0dip" android:color="#ffff7888" />
        </shape>
    </item>
</selector>